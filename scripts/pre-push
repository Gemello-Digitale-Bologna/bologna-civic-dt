#!/bin/sh
# A git hook (install: cp scripts/pre-push .git/hooks/): refuses a push
# whose commits have the core (civic-engagement) as a local checkout, set
# by `scripts/core.py local`: every install from GitHub would break.
# Commits with a local core are fine on a local branch; pin a commit of the
# core before pushing (python3 scripts/core.py <commit>), e.g. in the
# commit that squashes the branch.
zero=0000000000000000000000000000000000000000
local_core() {
  git show "$1:pyproject.toml" 2>/dev/null | grep -qE '^civic-engagement = \{ *path' && return 0
  git show "$1:uv.lock" 2>/dev/null | grep -A2 '^name = "civic-engagement"$' | grep -qE '^source = \{ *(editable|directory)' && return 0
  for file in frontend/package.json frontend/package-lock.json; do
    git show "$1:$file" 2>/dev/null | grep -qE '"civic-engagement": *"file:' && return 0
  done
  return 1
}
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # a deletion
  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for commit in $commits; do
    if local_core "$commit"; then
      echo "pre-push: $(git log -1 --format='%h %s' "$commit") has a local core." >&2
      status=1
    fi
  done
done
if [ $status -ne 0 ]; then
  echo "Pin a commit of the core first (python3 scripts/core.py <commit>), e.g. in a commit squashing the branch." >&2
  echo "(git push --no-verify to push anyway)" >&2
fi
exit $status
